NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3001

# postgresql://user:password@host:5432/db
DATABASE_URL=

# Must be at least 32 characters.
JWT_SECRET=

# Soroban RPC endpoint (e.g. https://soroban-testnet.stellar.org)
SOROBAN_RPC_URL=
STELLAR_NETWORK=testnet

# Deployed StellarTickets/blockchain `ticketing` contract address (C...)
TICKETING_CONTRACT_ID=

# Platform hot wallet used ONLY as a disposable source account for read-only
# contract simulations (verify_ticket, get_event). Never used to sign a
# write, and never a user's key.
PLATFORM_SIGNER_SECRET=

# Offline gate verification. See docs/OFFLINE_VERIFICATION.md for how to
# generate a keypair and how rotation works.
OFFLINE_SIGNING_KEY_ID=2026-01
# PEM-encoded Ed25519 private key, one line with \n escapes or a quoted
# multi-line value.
OFFLINE_SIGNING_PRIVATE_KEY=
# JSON map of every key id a scanner should still accept: {"2026-01":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}
OFFLINE_SIGNING_PUBLIC_KEYS=

# Ticket verification scan abuse prevention. Both have defaults if unset —
# see docs/RATE_LIMITING.md.
SCAN_RATE_LIMIT_MAX=10
SCAN_RATE_LIMIT_WINDOW_MS=60000

# Where rate-limit counters are stored: `memory` (default, per-process) or
# `redis` (shared across instances — required for multi-instance deployments).
# `redis` needs `npm install ioredis` and REDIS_URL. See docs/RATE_LIMITING.md.
RATE_LIMIT_STORE=memory
# REDIS_URL=redis://localhost:6379

# Maximum active resale listings per user (soft limit)
MAX_ACTIVE_RESALE_LISTINGS_PER_USER=5

# Pending transaction (build -> confirm intent) retention and cleanup cadence.
PENDING_TX_RETENTION_MINUTES=60
PENDING_TX_CLEANUP_INTERVAL_MINUTES=15

# How long a cached Idempotency-Key response is reused for build-transaction
# POST endpoints.
IDEMPOTENCY_KEY_TTL_MINUTES=15

# Experimental features. Flags are disabled unless explicitly set to true.
FEATURE_FEE_BUMP=false
FEATURE_INDEXER=false
